rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches(".*admin.*")
      );
    }

    function isValidProperty(data) {
      return data.title is string && data.title.size() > 0 &&
             data.price is number && data.price > 0 &&
             data.countryCode in ['NG', 'US', 'GB', 'AE'] &&
             data.luxuryCategory is string && data.luxuryCategory.size() > 0 &&
             data.listingType in ['sale', 'rent', 'shortlet'] &&
             data.bedrooms is number &&
             data.bathrooms is number &&
             data.agentId is string;
    }

    // Properties Collection (Browsing open to all clients, writes restricted to verified brokers/admins)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidProperty(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.agentId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.agentId || isAdmin());
    }

    // Client and Broker Profile Documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();

      // Notifications & Welcome Messages subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId);
      }
    }

    // Enquiries Collection
    match /enquiries/{enquiryId} {
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
    }

    // Inspections Collection
    match /inspections/{inspectionId} {
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
